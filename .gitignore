ios/Runner/GeneratedPluginRegistrant.*

# Generated Rust static libraries (make ios-native)
ios/Native/

# Xcode
**/xcuserdata/
**/*.xcuserstate
**/*.xcworkspace/xcuserdata/

DerivedData/

# Generated Rust frameworks / native artifacts
ios/**/*.framework/
ios/**/*.xcframework/

# But allow project-owned frameworks later if intentionally committed.
# Example:
# !ios/Frameworks/NixinRawEngine.xcframework/


